# Makefile for Test Suite

# Compiler settings
NVCC = nvcc
NVCC_FLAGS = -std=c++14 -O3 -I../include --compiler-options -Wall -rdc=true --use_fast_math -Wno-deprecated-gpu-targets

# Auto-detect GPU architecture if not specified
ifeq ($(GPU_ARCH),)
    DETECT_SCRIPT = $(shell dirname $(abspath $(lastword $(MAKEFILE_LIST))))/../detect_gpu_arch.sh
    ifeq ($(shell test -f $(DETECT_SCRIPT) && echo yes),yes)
        DETECTED_ARCH = $(shell bash $(DETECT_SCRIPT))
        GPU_ARCH = sm_$(DETECTED_ARCH)
        $(info Auto-detected GPU architecture: $(GPU_ARCH))
    else
        GPU_ARCH = sm_52
        $(info Using default GPU architecture: $(GPU_ARCH) (auto-detection unavailable))
    endif
else
    $(info Using specified GPU architecture: $(GPU_ARCH))
endif

# Source files
CPU_SOURCES = ../src/orderbook_cpu.cpp data_generator.cpp
CUDA_SOURCES = ../src/kernels.cu ../src/operations.cu
TEST_SOURCE = test_suite.cu

# Output
TEST_BIN = test_suite

# Targets
.PHONY: all clean run help

all: $(TEST_BIN)

$(TEST_BIN): $(TEST_SOURCE) $(CPU_SOURCES) $(CUDA_SOURCES)
	@echo "Compiling test suite..."
	$(NVCC) $(NVCC_FLAGS) -arch=$(GPU_ARCH) \
		$(TEST_SOURCE) \
		$(CPU_SOURCES) \
		$(CUDA_SOURCES) \
		-o $(TEST_BIN)
	@echo "Build complete: $(TEST_BIN)"

clean:
	@echo "Cleaning..."
	rm -f $(TEST_BIN)
	@echo "Clean complete"

run: $(TEST_BIN)
	@echo "Running comprehensive test suite..."
	@echo ""
	./$(TEST_BIN)

help:
	@echo "Available targets:"
	@echo "  make         - Build the test suite"
	@echo "  make clean   - Remove build artifacts"
	@echo "  make run     - Run all tests"
	@echo ""
	@echo "GPU Architecture:"
	@echo "  Current: $(GPU_ARCH)"
	@echo "  Change with: make GPU_ARCH=sm_86"

